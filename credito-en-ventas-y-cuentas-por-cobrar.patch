+  });
+
+  it("fully paid", () => {
+    const r = asignarPagosACuotas(cuotas, 1000, "2027-01-01");
+    expect(r.every((c) => c.estado === "PAGADA" && c.saldo === 0)).toBe(true);
+  });
+});
