# Copia este archivo a `.env` y ajusta los valores.
# El servicio `app` (desarrollo) y `test` de docker-compose.yml leen estas
# variables; producción se sirve con docker-compose.prod.yml.

# Secreto para firmar los JWT de sesión (obligatorio, mínimo 32 caracteres).
# En producción usa un valor largo y aleatorio — NO reutilices el de desarrollo.
JWT_SECRET=

# Base de datos. docker-compose la inyecta con el valor correcto del
# contenedor `db`; si corres `npm run dev` fuera de Docker, define aquí tu
# conexión local, p. ej. postgresql://dsm_user:dsm_password@localhost:5432/deposito_san_miguel
DATABASE_URL=

# Credenciales de Gmail para enviar el código 2FA (nodemailer).
# La "app password" se genera en https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Nivel mínimo de logs (pino). Vacío = automático por entorno:
#   development → debug, production → info, test → silent.
# Si se define, LOG_LEVEL siempre tiene prioridad.
# Valores válidos: trace, debug, info, warn, error, fatal.
LOG_LEVEL=

# ── Persistencia de logs en archivo rotado (opcional) ──────────────────────
# Si LOG_FILE_DIR está definido (y NO estás en modo test), el logger además
# de stdout escribe NDJSON a un archivo rotado por tamaño en ese directorio.
# En Docker se monta un volumen sobre él para que sobreviva a los recreos:
#   docker-compose.yml → volumen `logs_data:/app/logs` + LOG_FILE_DIR=/app/logs
# Rotación: LOG_FILE_MAX_SIZE de tamaño por archivo, conserva LOG_FILE_KEEP
# archivos y comprime los rotados con gzip.
LOG_FILE_DIR=
LOG_FILE_MAX_SIZE=50M
LOG_FILE_KEEP=5