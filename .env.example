# Copia este archivo a `.env` y ajusta los valores.
# El servicio `app` (desarrollo) y `test` de docker-compose.yml leen estas
# variables; producción se sirve con docker-compose.prod.yml.

# Secreto para firmar los JWT de sesión (obligatorio, mínimo 32 caracteres).
# En producción usa un valor largo y aleatorio — NO reutilices el de desarrollo.
JWT_SECRET=

# Base de datos. docker-compose la inyecta con el valor correcto del
# contenedor `db`; si corres `npm run dev` fuera de Docker, define aquí tu
# conexión local, p. ej. postgresql://dsm_user:dsm_password@localhost:5432/deposito_san_miguel
DATABASE_URL=

# Credenciales del Postgres de docker-compose. Deben coincidir entre sí:
# `DATABASE_URL` se arma con estos mismos valores.
# En producción los tres son obligatorios (no tienen default: docker-compose
# falla al arrancar si falta alguno, en vez de conectarse con una contraseña
# de desarrollo).
POSTGRES_USER=dsm_user
POSTGRES_PASSWORD=
POSTGRES_DB=deposito_san_miguel

# Acceso a pgAdmin (UI web de administración de la base).
# pgAdmin está detrás del perfil "tools": solo arranca con
#   docker compose --profile tools up -d pgadmin
# PGADMIN_DEFAULT_PASSWORD no tiene default a propósito, para que la
# contraseña nunca viva en el repositorio.
PGADMIN_DEFAULT_EMAIL=admin@dsm.com
PGADMIN_DEFAULT_PASSWORD=

# Credenciales del script de carga (carga.js). El script aborta si faltan, así
# que no puede ejecutarse con usuarios de ejemplo por accidente.
#   docker run --rm -i -e K6_DUENO_CORREO=... -e K6_DUENO_PASSWORD=... grafana/k6 run - < carga.js
K6_DUENO_CORREO=
K6_DUENO_PASSWORD=

# ── Respaldos de la base (scripts/backup-db.sh) ────────────────────────────
# Clave para cifrar los .sql.gz (AES-256-CBC vía openssl).
# Si NO se define, backup-db.sh genera el respaldo SIN cifrar y solo avisa por
# log: en producción eso deja la base completa en claro en disco. Define 32
# bytes en hexadecimal (openssl rand -hex 32).
BACKUP_ENCRYPTION_KEY=

# Credenciales de Gmail para enviar el código 2FA (nodemailer).
# La "app password" se genera en https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Servidor de correo (opcional — sustituye a Gmail) ──────────────────────
# Si NO defines SMTP_HOST, la app usa el preset "gmail" de nodemailer con
# GMAIL_USER / GMAIL_APP_PASSWORD (comportamiento histórico).
#
# Si defines SMTP_HOST, la app usa configuración SMTP genérica. Eso permite
# migrar a Mailgun, SES o al servidor corporativo SIN modificar código:
#
#   SMTP_HOST=smtp.corporativo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false          # true solo si el servidor usa TLS implícito (465)
#   SMTP_USER=notificaciones@tuempresa.com
#   SMTP_PASSWORD=clave
#
# SMTP_USER / SMTP_PASSWORD tienen prioridad sobre GMAIL_* si ambos están
# definidos. SMTP_SECURE acepta "true" o "false" (minúsculas).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Nivel mínimo de logs (pino). Vacío = automático por entorno:
#   development → debug, production → info, test → silent.
# Si se define, LOG_LEVEL siempre tiene prioridad.
# Valores válidos: trace, debug, info, warn, error, fatal.
LOG_LEVEL=

# ── Persistencia de logs en archivo rotado (opcional) ──────────────────────
# Si LOG_FILE_DIR está definido (y NO estás en modo test), el logger además
# de stdout escribe NDJSON a un archivo rotado por tamaño en ese directorio.
# En Docker se monta un volumen sobre él para que sobreviva a los recreos:
#   docker-compose.yml → volumen `logs_data:/app/logs` + LOG_FILE_DIR=/app/logs
# Rotación: LOG_FILE_MAX_SIZE de tamaño por archivo, conserva LOG_FILE_KEEP
# archivos y comprime los rotados con gzip.
LOG_FILE_DIR=
LOG_FILE_MAX_SIZE=50M
LOG_FILE_KEEP=5